BASE_URL=
API_KEY=

# NextAuth
AUTH_SECRET=your-secret-key-here

# Auth bypass mode for feature testing (set to true to disable auth guard)
AUTH_BYPASS=false
AUTH_BYPASS_USER_ID=test-user
AUTH_BYPASS_USER_EMAIL=test-user@local.dev
AUTH_BYPASS_USER_NAME=Test User

# TTS specific configurations
TTS_API_URL=

# AI-depict specific configurations
# Set to 'true' to enable AI-depict feature, 'false' or omit to disable
ENABLE_AI_DEPICT=true

# AI-depict API URL (only used if ENABLE_AI_DEPICT is true)
AI_DEPICT_API_URL=